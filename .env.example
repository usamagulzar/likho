# Neon Postgres pooled connection string (include sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local URL for development; use your production origin on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Password-reset emails are sent through Gmail SMTP.
# GMAIL_USER is the Gmail address that sends the emails. GMAIL_APP_PASSWORD is a Google
# "app password" (Google Account > Security > 2-Step Verification > App passwords), NOT your normal password.
# Optional in development: with no credentials, the reset link is printed in the dev server console instead.
# Required in production.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public URL of the site, used for canonical URLs, the sitemap, robots.txt, Open Graph images and llms.txt.
# On Vercel it falls back to the production domain automatically; set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
